static var language: String = "zh_CN"
static var _patterns: Array[RegEx] = []
static var _cache: Dictionary = {}


static func set_language(code: String) -> void:
	language = "en" if code == "en" else "zh_CN"


static func chinese() -> bool:
	return language == "zh_CN"


static func translate(value: String) -> String:
	if not chinese() or value.is_empty():
		return value
	var key: String = value.to_upper()
	if TEXT.has(key):
		return str(TEXT[key])
	if _cache.has(value):
		return str(_cache[value])
	_prepare_patterns()
	var translated: String = value
	for index: int in range(_patterns.size()):
		var found: RegExMatch = _patterns[index].search(value)
		if found == null:
			continue
		translated = str(TEMPLATES[index][1])
		for group: int in range(1, found.get_group_count() + 1):
			var fragment: String = found.get_string(group).strip_edges()
			translated = translated.replace("{%d}" % group, str(TEXT.get(fragment.to_upper(), fragment)))
		break
	# HUD counters change continuously; cap the display cache for long sessions.
	if _cache.size() >= 512:
		_cache.clear()
	_cache[value] = translated
	return translated


static func _prepare_patterns() -> void:
	if not _patterns.is_empty():
		return
	for definition: Array in TEMPLATES:
		var pattern := RegEx.new()
		var error: Error = pattern.compile("(?i)" + str(definition[0]))
		assert(error == OK, "Invalid localization pattern: " + str(definition[0]))
		_patterns.append(pattern)
