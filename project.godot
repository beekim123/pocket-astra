; Lanternwake — all assets are generated at runtime from source.
config_version=5

[application]
config/name="Lanternwake — The First Light"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="An original code-crafted creature RPG. Explore, befriend, and rekindle the lighthouse."
config/use_custom_user_dir=true
config/custom_user_dir_name="Lanternwake"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.08, 0.15, 0.20, 1)
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=1

[physics]
common/physics_ticks_per_second=60

[threading]
worker_pool/max_threads=1

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=0

